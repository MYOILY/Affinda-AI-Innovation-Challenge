# Copy to .env.local. Every key is optional: without one, the demo uses built-in rules and
# fixed wording, so it always runs.

# Walkie audio -> text (the "Upload walkie audio" button). Server-side only.
ELEVENLABS_API_KEY=

# Lets a model read reports, classify incidents and word radio announcements and texts.
# It can only raise an incident's urgency, never lower it, and can never change who is moved.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
